# ============================================================
# Supabase - variáveis disponíveis no código executado no client
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# Supabase - variáveis utilizadas pelo código server-side
# ============================================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# Supabase - credencial administrativa SOMENTE SERVER-SIDE
#
# Nunca utilizar prefixo VITE_ nesta variável.
# Nunca expor esta chave no navegador.
#
# Será necessária posteriormente para operações administrativas
# seguras, como criação e gerenciamento de usuários.
# ============================================================

SUPABASE_SERVICE_ROLE_KEY=
